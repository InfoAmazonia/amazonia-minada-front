# build environment
FROM node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 AS build
WORKDIR /app
ENV PATH=/app/node_modules/.bin:$PATH
COPY package.json yarn.lock ./
RUN --mount=type=cache,id=minada-front-yarn-v1,target=/usr/local/share/.cache/yarn yarn install --frozen-lockfile --non-interactive --ignore-scripts
COPY .eslintrc.js .prettierrc ./
COPY public ./public
COPY src ./src
COPY .env ./.env
# CRA 4 exact dependency pins are intentionally overridden with current-Node-compatible patches.
# This exception applies only to the build; output is tested before deployment.
RUN SKIP_PREFLIGHT_CHECK=true NODE_OPTIONS=--max-old-space-size=2048 yarn build

# production environment
FROM nginx:1.30.6-alpine@sha256:970364228b1e4f932abc22d321932816782cca8a20b85a77552a7cfe9acfb3b5
COPY nginx/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
CMD ["nginx", "-g", "daemon off;"]
